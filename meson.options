option(
	'vendored_wlroots',
	type: 'boolean',
	value: true,
	description: 'Build the pinned wlroots in subprojects/ and link it statically',
)
option(
	'machine',
	type: 'string',
	value: 'auto',
	description: 'Which src/machines/<name>.h holds this machine\'s settings (screens, sleep). auto: the one named after the board, else default',
)
option(
	'bluetooth',
	type: 'boolean',
	value: true,
	description: 'Install tw-bluetooth and keep the Bluetooth driver from loading at boot: Bluetooth is off until `tw-bluetooth on`',
)
option(
	'thunderbolt',
	type: 'boolean',
	value: true,
	description: 'Install the udev rule that lets Thunderbolt devices in where the kernel protects its memory from them, which is what boltd does there',
)
option(
	'notify',
	type: 'feature',
	value: 'auto',
	description: 'Build tw-notify, the notification service (needs fontconfig and FreeType)',
)
