#!/bin/sh
# Sets the machine's power profile, or lets the keyboards and mice plugged in
# sleep and wakes them. Run as root by tw-power@<word>.service, which
# tw-power starts; the only input is the word from the unit's name.
#
# A profile is three settings, the same three power-profiles-daemon writes,
# so that no daemon has to stay around to write them (and the CPU governor,
# where the performance one would refuse the second):
#   the platform's own profile, which is fans and power limits
#   how each CPU weighs speed against power (energy_performance_preference)
#   the older hint to the same end (energy_perf_bias)
# A machine that lacks one of them is not given it.
set -u

sys=${TW_SYS:-/sys} # the tests point this at a made-up machine

case ${1:-} in
saver)
	# Some machines call their most frugal profile low-power, some quiet.
	platform="low-power quiet"
	preference=power
	bias=15
	;;
balanced)
	platform=balanced
	preference=balance_performance
	bias=6
	;;
performance)
	platform=performance
	preference=performance
	bias=0
	;;
away | back) ;;
*)
	echo "usage: tw-power-root saver|balanced|performance|away|back" >&2
	exit 2
	;;
esac

# systemd runs two of these units side by side: tw starts one at a time
# and in order, but a profile set by hand can come at the same moment. One
# at a time, whichever comes last is set whole, never a mix of the two.
exec 9>"${TW_RUN:-/run}/tw-power.lock"
flock 9

failed=0
# put <file> <value>: writes the value, unless the file is not there or says
# so already.
put() {
	[ -e "$1" ] || return 0
	[ "$(cat "$1" 2>/dev/null)" = "$2" ] && return 0
	if ! echo "$2" 2>/dev/null >"$1"; then
		echo "tw-power: could not write '$2' to $1" >&2
		failed=1
	fi
}
# offered <file> <value>: true if the file lists the value, or is not there
# to say what may be written.
offered() {
	[ -e "$1" ] || return 0
	case " $(cat "$1" 2>/dev/null) " in
	*" $2 "*) return 0 ;;
	esac
	return 1
}

# away: a keyboard or mouse plugged in may sleep, as the laptop's own keyboard
# always may (tw-keyboard.rules), while the screen is off. Awake, it is polled
# every millisecond or so, and that alone keeps the processor out of its
# deepest sleep. Not while the screen is on: such a keyboard may lose what is
# typed as it wakes, and such a mouse may wake on a click only. So tw runs
# this as the screen goes off, and back as it comes on.
#
# Which: a USB device the firmware does not call built in (removable is not
# "fixed"), able to wake the machine (bit 5 of bmAttributes; the kernel lets
# no other input device sleep anyway), kept awake now (power/control "on"),
# with a boot keyboard or boot mouse interface (HID class 03, subclass 01,
# protocol 01 or 02). Each one let sleep is listed in $list, so that back
# wakes only those, and only when there is a list.
list=${TW_RUN:-/run}/tw-power-away
inputs() {
	for dev in "$sys"/bus/usb/devices/*; do
		[ -e "$dev/bmAttributes" ] && [ -e "$dev/power/control" ] || continue
		[ "$(cat "$dev/removable" 2>/dev/null)" != fixed ] || continue
		[ "$(cat "$dev/power/control")" = on ] || continue
		[ $((0x$(cat "$dev/bmAttributes") & 0x20)) -ne 0 ] || continue
		for interface in "$dev/${dev##*/}":*; do
			[ "$(cat "$interface/bInterfaceClass" 2>/dev/null)" = 03 ] &&
				[ "$(cat "$interface/bInterfaceSubClass" 2>/dev/null)" = 01 ] || continue
			case $(cat "$interface/bInterfaceProtocol" 2>/dev/null) in
			01 | 02)
				echo "$dev"
				break
				;;
			esac
		done
	done
}
case $1 in
away)
	for dev in $(inputs); do
		put "$dev/power/control" auto
		[ "$(cat "$dev/power/control")" = auto ] && echo "$dev" >>"$list"
	done
	exit "$failed"
	;;
back)
	if [ -e "$list" ]; then
		while read -r dev; do
			# Gone since, or plugged out and in: then it is awake already.
			[ -e "$dev/power/control" ] && put "$dev/power/control" on
		done <"$list"
		rm -f "$list"
	fi
	exit "$failed"
	;;
esac

for name in $platform; do
	if offered "$sys/firmware/acpi/platform_profile_choices" "$name"; then
		put "$sys/firmware/acpi/platform_profile" "$name"
		break
	fi
done
for policy in "$sys"/devices/system/cpu/cpufreq/policy*; do
	# Under the performance governor the CPU refuses every preference but
	# performance (intel_pstate and amd-pstate alike), so the profile takes
	# the governor that weighs the two, as power-profiles-daemon does. Only
	# where there is a preference to weigh: without one (acpi-cpufreq, or
	# either driver in passive mode) powersave pins the CPU to its slowest.
	if [ "$preference" != performance ] &&
		[ -e "$policy/energy_performance_available_preferences" ] &&
		[ "$(cat "$policy/scaling_governor" 2>/dev/null)" = performance ] &&
		offered "$policy/scaling_available_governors" powersave; then
		put "$policy/scaling_governor" powersave
	fi
	offered "$policy/energy_performance_available_preferences" "$preference" &&
		put "$policy/energy_performance_preference" "$preference"
done
for cpu in "$sys"/devices/system/cpu/cpu[0-9]*; do
	put "$cpu/power/energy_perf_bias" "$bias"
done
exit "$failed"
