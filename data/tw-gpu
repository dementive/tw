#!/bin/sh
# tw-gpu: keeps a laptop's NVIDIA GPU switched off, and switches it on for
# the programs that want it.
#
#   tw-gpu run <command...>     run a program on the NVIDIA GPU. The GPU is
#                               switched on first, and off again once the
#                               program and everything it started are gone.
#   tw-gpu launch <command...>  for the launcher: like run when the desktop
#                               entry being started asks for the discrete GPU
#                               (PrefersNonDefaultGPU=true), else runs the
#                               command as it is.
#   tw-gpu on                   switch it on and leave it on.
#   tw-gpu off                  switch it off; refused while it is in use.
#   tw-gpu status
#
# Off means the NVIDIA kernel driver is not loaded: the GPU is powered down,
# nothing can wake it, and the memory the driver keeps (about 380 MB) is free.
# Loading and unloading it needs root, so that part is done by the system
# unit tw-gpu@.service, which a polkit rule lets you start.
#
# On a machine with no NVIDIA GPU every command here just runs the program.
set -u

sys=${TW_SYS:-/sys}     # the tests point these at a made-up machine
dev=${TW_DEV:-/dev}
runtime=${XDG_RUNTIME_DIR:-/tmp}
# Held shared by every program started with run, for as long as it or
# anything it started is alive; switching off takes it exclusively.
lock=$runtime/tw-gpu.lock
# Present while `tw-gpu on` is in force.
keep=$runtime/tw-gpu.keep

usage() {
	sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2
	exit 2
}

# Prints the NVIDIA GPU's directory in sysfs; fails if there is none.
gpu_device() {
	for device in "$sys"/bus/pci/devices/*; do
		[ -r "$device/vendor" ] && [ -r "$device/class" ] || continue
		[ "$(cat "$device/vendor")" = 0x10de ] || continue
		case $(cat "$device/class") in
		0x03*)
			echo "$device"
			return 0
			;;
		esac
	done
	return 1
}

loaded() { [ -d "$sys/module/nvidia" ]; }

# Programs reach the GPU through its render node, which udev makes usable a
# moment after the driver has loaded.
render_node_ready() {
	for node in "$1"/drm/renderD*; do
		[ -e "$node" ] || return 1
		[ -r "$dev/dri/${node##*/}" ] && [ -w "$dev/dri/${node##*/}" ]
		return
	done
}

# True if tw itself drives a monitor with this GPU: then it stays on.
drives_a_monitor() {
	for card in "$1"/drm/card[0-9]*; do
		case ":${WLR_DRM_DEVICES:-}:" in
		*":/dev/dri/${card##*/}:"*) return 0 ;;
		esac
	done
	return 1
}

gpu_on() {
	device=$(gpu_device) || return 1
	if ! [ -d "$sys/module/nvidia_drm" ]; then
		systemctl start tw-gpu@on.service 2>/dev/null || return 1
	fi
	tries=0
	until render_node_ready "$device"; do
		tries=$((tries + 1))
		[ "$tries" -le 50 ] || return 1
		sleep 0.1
	done
}

# Fails if the driver is still loaded afterwards: something is using the GPU.
gpu_off() {
	loaded || return 0
	device=$(gpu_device) || return 0
	drives_a_monitor "$device" && return 1
	systemctl start tw-gpu@off.service 2>/dev/null
	! loaded
}

# True if the desktop entry with this ID asks for the discrete GPU.
wants_gpu() {
	[ -n "$1" ] || return 1
	old_ifs=$IFS
	IFS=:
	for dir in ${XDG_DATA_HOME:-$HOME/.local/share} ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
		IFS=$old_ifs
		[ -r "$dir/applications/$1" ] || continue
		# The first entry found is the one the launcher started.
		grep -Eq '^(PrefersNonDefaultGPU|X-KDE-RunOnDiscreteGpu)=true' "$dir/applications/$1"
		return
	done
	IFS=$old_ifs
	return 1
}

case ${1:-} in
run)
	shift
	[ $# -gt 0 ] || usage
	gpu_device >/dev/null || exec "$@"
	exec 9>"$lock"
	flock -s 9 # also waits for a switch-off in progress to finish
	if gpu_on; then
		(
			# The session keeps programs on the other GPU with the first
			# two; the rest are NVIDIA's way of asking for theirs.
			unset __EGL_VENDOR_LIBRARY_FILENAMES VK_DRIVER_FILES
			export __NV_PRIME_RENDER_OFFLOAD=1
			export __VK_LAYER_NV_optimus=NVIDIA_only
			export __GLX_VENDOR_LIBRARY_NAME=nvidia
			exec "$@"
		)
	else
		echo "tw-gpu: could not switch the NVIDIA GPU on; running without it" >&2
		"$@"
	fi
	status=$?
	exec 9>&-
	# Whatever the program left running still holds the lock. Wait for that
	# too, detached, so that this command returns when the program does.
	setsid -f "$0" settle </dev/null >/dev/null 2>&1
	exit "$status"
	;;
settle) # internal: switch off once nothing started with run is left
	exec 9>"$lock"
	flock -x 9
	[ -e "$keep" ] || gpu_off
	;;
launch)
	shift
	[ $# -gt 0 ] || usage
	if wants_gpu "${DESKTOP_ENTRY_ID:-${FUZZEL_DESKTOP_FILE_ID:-}}"; then
		exec "$0" run "$@"
	fi
	exec "$@"
	;;
on)
	if ! gpu_device >/dev/null; then
		echo "tw-gpu: this machine has no NVIDIA GPU" >&2
		exit 1
	fi
	: >"$keep"
	exec 9>"$lock"
	flock -s 9
	if ! gpu_on; then
		echo "tw-gpu: could not switch the NVIDIA GPU on" >&2
		exit 1
	fi
	;;
off)
	rm -f "$keep"
	exec 9>"$lock"
	if ! flock -x -n 9; then
		echo "tw-gpu: a program started with tw-gpu is still running" >&2
		exit 1
	fi
	if ! gpu_off; then
		echo "tw-gpu: the NVIDIA GPU is in use and stays on" >&2
		exit 1
	fi
	;;
status)
	if ! device=$(gpu_device); then
		echo "no NVIDIA GPU"
		exit 0
	fi
	if loaded; then
		case $(cat "$device/power/runtime_status" 2>/dev/null) in
		suspended) state="on, asleep" ;;
		*) state="on, awake" ;;
		esac
		[ -e "$keep" ] && state="$state, kept on by 'tw-gpu on'"
		drives_a_monitor "$device" && state="$state, drives a monitor"
	else
		power=$(cat "$device/power_state" 2>/dev/null)
		case $power in
		D3cold) state="off, powered down" ;;
		*) state="off, but still powered (${power:-unknown})" ;;
		esac
	fi
	echo "NVIDIA GPU ${device##*/}: $state"
	;;
*)
	usage
	;;
esac
