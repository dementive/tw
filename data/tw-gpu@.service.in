# tw-gpu@on.service puts the NVIDIA GPU back on the PCI bus and loads its
# driver; tw-gpu@off.service unloads the driver and takes the GPU off the bus.
# Started by tw-gpu; tw-gpu.rules lets the person at the computer do that
# without a password.
[Unit]
Description=Switch the NVIDIA GPU %i (tw-gpu)
# Started at every launch of a program that wants the GPU: never refused
# for starting too often.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# A driver that hangs as it loads or unloads must not hold every later
# start, and the program waiting to launch, forever.
TimeoutStartSec=90
ExecStart=@libexecdir@/tw-gpu-root %i
