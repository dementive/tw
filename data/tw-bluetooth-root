#!/bin/sh
# Switches Bluetooth on or off. Run as root by tw-bluetooth@on.service and
# tw-bluetooth@off.service, which tw-bluetooth starts, and by
# tw-bluetooth@idle.service, which a timer starts; the only input is the
# word from the unit's name.
#
# Off: the Bluetooth service is stopped and every Bluetooth module is
# unloaded, the adapter's driver among them. With no driver there is no
# adapter, so nothing starts the service again, and the radio has no power.
# On: the adapter's driver is loaded, and any other this helper unloaded.
# systemd starts the service by itself when the adapter appears, as it does
# on any machine that boots with one.
# Idle: off, if it was this helper that switched Bluetooth on and nothing
# is connected.
set -u

sys=${TW_SYS:-/sys} # the tests point these at a made-up machine
# The drivers kept from loading as the machine starts, which makes them the
# ones to load here: every "blacklist" line of this file names one.
conf=${TW_BLUETOOTH_CONF:-/usr/local/lib/modprobe.d/tw-bluetooth.conf}
# Present while Bluetooth is on because this helper switched it on. The
# Bluetooth service starts only while it is there (tw-bluetooth-service.conf),
# and only then does Bluetooth go off by itself. An adapter whose driver is
# not in $conf is there from boot, but its service waits for `on` all the
# same.
flag=${TW_RUN:-/run}/tw-bluetooth
# The modules this helper has unloaded since the machine started, one name
# a line. An adapter on another bus than USB may have a driver $conf does
# not name, which is there from boot; once unloaded, it has to be loaded
# again by name.
unloaded=${TW_RUN:-/run}/tw-bluetooth-unloaded
service=bluetooth.service
timer=tw-bluetooth-idle.timer

# on, off and idle are three units, which systemd would run side by side:
# the timer running out during an `on` would switch Bluetooth off again
# halfway. One at a time.
exec 9>"${TW_RUN:-/run}/tw-bluetooth.lock"
flock 9

# True if there is an adapter: hci0 and so on.
adapter() {
	for device in "$sys"/class/bluetooth/hci*; do
		[ -e "$device" ] && return 0
	done
	return 1
}

# True if a device is connected. The kernel keeps each connection next to
# its adapter, named after it with a colon and a number: hci0:256.
connected() {
	for link in "$sys"/class/bluetooth/hci*:*; do
		[ -e "$link" ] && return 0
	done
	return 1
}

# Lifts the block on every Bluetooth radio, as `rfkill unblock bluetooth`
# does.
unblock() {
	for switch in "$sys"/class/rfkill/rfkill*; do
		[ "$(cat "$switch/type" 2>/dev/null)" = bluetooth ] || continue
		[ "$(cat "$switch/soft" 2>/dev/null)" = 0 ] || echo 0 >"$switch/soft"
	done
}

# The drivers to load: every "blacklist" line of $conf names one, and so
# does every line of $unloaded.
drivers() {
	{
		sed -n 's/^[[:space:]]*blacklist[[:space:]]\{1,\}\([^[:space:]]\{1,\}\).*/\1/p' "$conf"
		cat "$unloaded"
	} 2>/dev/null | awk '!seen[$0]++' | tr '\n' ' '
}

switch_off() {
	# First: without it the service that is about to be stopped cannot be
	# started again by whoever calls it next, and the connections ending
	# now do not start the timer.
	rm -f "$flag"
	systemctl stop "$timer" 2>/dev/null
	[ -d "$sys/module/bluetooth" ] || return 0
	# The service has the modules open, so it goes before them.
	systemctl stop "$service" 2>/dev/null
	# Every module that needs the Bluetooth core, then the core. Removing a
	# driver takes along what only it needed (btintel with btusb), so each
	# is looked for again before it is removed. And more than once: a
	# program that had a device open, the sound service for one, takes a
	# moment to let go after the Bluetooth service has gone.
	passes=0
	while :; do
		for holder in "$sys"/module/bluetooth/holders/*; do
			[ -e "$holder" ] || continue
			module=${holder##*/}
			modprobe -r "$module" 2>/dev/null || continue
			grep -qx "$module" "$unloaded" 2>/dev/null || echo "$module" >>"$unloaded"
		done
		modprobe -r bluetooth 2>/dev/null
		[ -d "$sys/module/bluetooth" ] || return 0
		passes=$((passes + 1))
		[ "$passes" -lt 5 ] || break
		sleep 0.5
	done
	echo "tw-bluetooth: a program still has Bluetooth open; its modules stay loaded" >&2
	return 1
}

case ${1:-} in
on)
	drivers=$(drivers)
	if [ -z "$drivers" ]; then
		echo "tw-bluetooth: $conf names no driver to load" >&2
		exit 1
	fi
	# Before the driver: systemd starts the service when the adapter
	# appears, and the service starts only with this in place.
	: >"$flag"
	for driver in $drivers; do
		# One that this machine has no use for may fail; what counts is
		# whether an adapter turns up.
		modprobe "$driver"
	done
	# The adapter is there as soon as its driver has found it.
	tries=0
	until adapter; do
		tries=$((tries + 1))
		if [ "$tries" -ge 25 ]; then
			echo "tw-bluetooth: no Bluetooth adapter appeared after loading: $drivers" >&2
			for driver in $drivers; do
				modinfo "$driver" >/dev/null 2>&1 ||
					echo "tw-bluetooth: $driver is not on the disk for the running kernel; reboot after a kernel update" >&2
			done
			switch_off
			exit 1
		fi
		sleep 0.2
	done
	# systemd puts the radio's block back to what it was when the adapter
	# was last there, a moment after udev is done with the adapter. If that
	# was "blocked", a block lifted before then would come back. So give
	# systemd that moment first. It takes note of the block being lifted,
	# and what it puts back from then on is "not blocked".
	udevadm settle --timeout=5
	sleep 1
	unblock
	# Off again once nothing has been connected for a while.
	systemctl restart "$timer"
	# systemd starts the service when an adapter appears. One that was there
	# already, because an earlier off could not unload its driver, brings no
	# such event. Without bluez there is no service, and the adapter is on
	# all the same.
	systemctl start --no-block "$service" 2>/dev/null ||
		echo "tw-bluetooth: $service could not be started; is bluez installed?" >&2
	;;
off)
	switch_off
	;;
idle)
	[ -e "$flag" ] || exit 0
	connected && exit 0
	# An `on` rewrites the note. One that finished while this waited for
	# the lock has just started the timer over, and nothing has had time
	# to connect yet.
	[ -n "$(find "$flag" -mmin +5)" ] || exit 0
	# After a kernel update the running kernel's modules are gone from the
	# disk until the next boot: unloaded now, Bluetooth could not come back.
	# What counts is what switch_off would unload; a driver $conf names for
	# another machine is not loaded here, and must not keep Bluetooth on.
	for holder in "$sys"/module/bluetooth/holders/*; do
		[ -e "$holder" ] || continue
		modinfo "${holder##*/}" >/dev/null 2>&1 || exit 0
	done
	switch_off
	;;
*)
	echo "usage: tw-bluetooth-root on|off|idle" >&2
	exit 2
	;;
esac
