# A Bluetooth adapter on USB may go to sleep when it has nothing to do. Its
# driver allows that as it loads; with the driver kept away nobody does, and
# the adapter would sit awake for as long as the machine runs.
#
# Matched by its Bluetooth interface (class e0, 01, 01), which every adapter
# has: some also say so for the whole device, but a chip that is Wi-Fi and
# Bluetooth in one often calls itself something else (ef, 02, 01, or 00).
# Sleeping is a matter of the whole device, the interface's parent; a device
# sleeps only when the drivers of all its interfaces allow it.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", \
    ATTR{bInterfaceClass}=="e0", ATTR{bInterfaceSubClass}=="01", ATTR{bInterfaceProtocol}=="01", \
    TEST=="../power/control", ATTR{../power/control}="auto"

# A connection ended while Bluetooth is on because tw-bluetooth switched it
# on: start the wait for the next one over. When it runs out with nothing
# connected, Bluetooth goes off.
ACTION=="remove", SUBSYSTEM=="bluetooth", ENV{DEVTYPE}=="link", TEST=="/run/tw-bluetooth", \
    RUN+="/usr/bin/systemctl --no-block restart tw-bluetooth-idle.timer"
