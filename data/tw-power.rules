// Lets tw-power set the machine's power profile without asking for a
// password. It does so by starting one of three units, and this allows
// exactly that: for whoever sits at the computer, and for administrators.
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
			action.lookup("verb") == "start" &&
			(action.lookup("unit") == "tw-power@saver.service" ||
			 action.lookup("unit") == "tw-power@balanced.service" ||
			 action.lookup("unit") == "tw-power@performance.service") &&
			((subject.local && subject.active) || subject.isInGroup("wheel"))) {
		return polkit.Result.YES;
	}
});
