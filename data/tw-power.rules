// Lets tw-power set the machine's power profile, and let the keyboards and
// mice sleep and wake them, without asking for a password. It does so by
// starting one of five units, and this allows exactly that: for whoever sits
// at the computer, and for administrators.
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
			action.lookup("verb") == "start" &&
			(action.lookup("unit") == "tw-power@saver.service" ||
			 action.lookup("unit") == "tw-power@balanced.service" ||
			 action.lookup("unit") == "tw-power@performance.service" ||
			 action.lookup("unit") == "tw-power@away.service" ||
			 action.lookup("unit") == "tw-power@back.service") &&
			((subject.local && subject.active) || subject.isInGroup("wheel"))) {
		return polkit.Result.YES;
	}
});
