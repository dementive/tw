# tw-power@saver.service, tw-power@balanced.service and
# tw-power@performance.service set the machine's power profile;
# tw-power@away.service lets the keyboards and mice plugged in sleep, and
# tw-power@back.service wakes them. Started by tw-power; tw-power.rules lets
# the person at the computer do that without a password.
[Unit]
Description=tw-power %i
# Started at every move of the power cable, and a loose one moves often, and
# each time the screen goes off or on: never refused for starting too often.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# A firmware setting that hangs as it is written must not hold every
# later profile forever.
TimeoutStartSec=90
ExecStart=@libexecdir@/tw-power-root %i
