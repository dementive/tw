#!/bin/sh
# Starts tw as a login session. The login screen runs this through
# tw.desktop; it also works when typed on a text console.
#
# Environment you can set beforehand:
#   WLR_DRM_DEVICES   which GPUs to use, the one that renders first
#   TW_ALL_GPUS=1     use every GPU, whether or not a monitor is plugged into
#                     the second one; costs its power and memory all session
#
# Programs to start with the session are listed in config.h (autostart). For
# anything not worth a rebuild there is also ~/.config/tw/autostart, an
# executable script.

# This script starts tw as the whole session, on the real screen. Drop any
# host display from the environment, or tw would try to open a window on it.
# (To run tw in a window inside another session, run `tw` itself.)
unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY

export XDG_CURRENT_DESKTOP=tw
export XDG_SESSION_DESKTOP=tw
export XDG_SESSION_TYPE=wayland
# X11 applications work, but the first one starts Xwayland and
# xwayland-satellite, which then stay in memory for the rest of the session.
# Ask toolkits that would default to X11 to use Wayland instead.
export ELECTRON_OZONE_PLATFORM_HINT=auto
export MOZ_ENABLE_WAYLAND=1
# Chromium and Electron programs (the Claude app, VS Code) pick their keyring
# by desktop name alone. For one they do not know they use none, and then
# cannot keep a login. This variable is the old way of saying "use the
# desktop's keyring service", and is the only hint they take from the
# environment that does not rename the desktop.
export GNOME_DESKTOP_SESSION_ID=this-is-deprecated

# On a laptop with two GPUs, render on the one wired to the built-in panel
# (the "boot VGA" device). The other GPU is used only if a monitor is plugged
# into one of its ports as the session starts: opening it loads its driver
# and keeps it powered, which is not worth paying just in case. A monitor
# plugged into such a port later needs a new login (or TW_ALL_GPUS=1); ports
# wired to the first GPU work at any time.
if [ -z "${WLR_DRM_DEVICES:-}" ] && [ -z "${TW_ALL_GPUS:-}" ]; then
	cards=0
	primary=
	others=
	for card in /sys/class/drm/card[0-9]*; do
		[ -e "$card/device/boot_vga" ] || continue # skips connectors
		cards=$((cards + 1))
		if [ "$(cat "$card/device/boot_vga")" = 1 ]; then
			primary=${card##*/}
			continue
		fi
		for status in "$card"-*/status; do
			if [ -e "$status" ] && [ "$(cat "$status")" = connected ]; then
				others="$others:/dev/dri/${card##*/}"
				break
			fi
		done
	done
	if [ "$cards" -gt 1 ] && [ -n "$primary" ]; then
		export WLR_DRM_DEVICES="/dev/dri/$primary$others"
		# With one GPU in use, likewise keep other vendors' EGL libraries out
		# of the session when that GPU uses Mesa. Programs started from tw
		# inherit this and render on the same GPU; unset it for one that
		# should use the other:
		#   env -u __EGL_VENDOR_LIBRARY_FILENAMES <program>
		# With two in use tw needs the second vendor's library itself.
		driver=$(basename "$(readlink "/sys/class/drm/$primary/device/driver")")
		mesa_egl=/usr/share/glvnd/egl_vendor.d/50_mesa.json
		if [ -z "$others" ] && [ "$driver" != nvidia ] && [ -f "$mesa_egl" ]; then
			export __EGL_VENDOR_LIBRARY_FILENAMES="$mesa_egl"
		fi
	fi
fi

# Once tw is up: tell D-Bus and systemd about the session so portals and
# services can find it, then run the user's autostart script.
startup='
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
	dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP \
		${DISPLAY:+DISPLAY}
fi
# The keyring. A login screen set up for KDE unlocks the KDE wallet with the
# login password and leaves its daemon running, waiting to be told where the
# session is; KDE does that from its autostart. Do the same, and the daemon
# serves as the keyring (the Secret Service) without asking for a password.
if [ -n "${PAM_KWALLET5_LOGIN:-}" ]; then
	for init in /usr/lib/pam_kwallet_init /usr/libexec/pam_kwallet_init; do
		if [ -x "$init" ]; then
			"$init"
			break
		fi
	done
fi
autostart="${XDG_CONFIG_HOME:-$HOME/.config}/tw/autostart"
if [ -x "$autostart" ]; then
	exec "$autostart"
fi
'

# Prefer the tw installed next to this script.
tw=$(dirname "$0")/tw
[ -x "$tw" ] || tw=tw
exec "$tw" -s "$startup"
