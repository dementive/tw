#!/bin/sh
# Starts tw as a login session. The login screen runs this through
# tw.desktop; it also works when typed on a text console.
#
# Environment you can set beforehand:
#   WLR_DRM_DEVICES   which GPUs to use, the one that renders first
#   TW_ALL_GPUS=1     use every GPU, whether or not a monitor is plugged into
#                     the second one, and bring back one that tw-gpu switched
#                     off; costs its power and memory all session
#   TW_A11Y=1         keep the accessibility bus, for a screen reader
#   TW_SESSION_PRINT=1  print which GPUs would be used, and start nothing
#
# Programs to start with the session are listed in config.h (autostart). For
# anything not worth a rebuild there is also ~/.config/tw/autostart, an
# executable script.

# This script starts tw as the whole session, on the real screen. Drop any
# host display from the environment, or tw would try to open a window on it.
# (To run tw in a window inside another session, run `tw` itself.)
unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY

export XDG_CURRENT_DESKTOP=tw
export XDG_SESSION_DESKTOP=tw
export XDG_SESSION_TYPE=wayland
# X11 applications work, but each needs Xwayland and xwayland-satellite
# started, and those stay for as long as it runs. Ask toolkits that would
# default to X11 to use Wayland instead.
export ELECTRON_OZONE_PLATFORM_HINT=auto
export MOZ_ENABLE_WAYLAND=1
# Chromium and Electron programs (the Claude app, VS Code) pick their keyring
# by desktop name alone. For one they do not know they use none, and then
# cannot keep a login. This variable is the old way of saying "use the
# desktop's keyring service", and is the only hint they take from the
# environment that does not rename the desktop.
export GNOME_DESKTOP_SESSION_ID=this-is-deprecated

# On a laptop with two GPUs, render on the one wired to the built-in panel.
# The other GPU is used only if a monitor is plugged into one of its ports as
# the session starts: opening it loads its driver and keeps it powered, which
# is not worth paying just in case. A monitor plugged into such a port later
# needs a new login, after `tw-gpu on` if tw-gpu has switched that GPU off
# since the boot (or TW_ALL_GPUS=1); ports wired to the first GPU work at any
# time.
sys=${TW_SYS:-/sys}             # the tests point these at a made-up machine
share=${TW_SHARE:-/usr/share}
run=${TW_RUN:-/run}
wake_step=
gpu_step=
primary=
why=
# connected <card> <connector types...>: true if a monitor is connected to one
# of the card's connectors of these types (all of them with none named).
connected() {
	connectors=$sys/class/drm/$1-
	shift
	[ $# -gt 0 ] || set -- ''
	for type in "$@"; do
		for status in "$connectors$type"*/status; do
			[ -e "$status" ] && [ "$(cat "$status")" = connected ] && return 0
		done
	done
	return 1
}
if [ -z "${WLR_DRM_DEVICES:-}" ] && [ -n "${TW_ALL_GPUS:-}" ] && [ -e "$run/tw-gpu-off" ]; then
	# Every GPU includes the NVIDIA GPU that tw-gpu took off the bus earlier
	# this boot: bring it back for tw to open. Through `run` and not `on`,
	# so that nothing keeps it on for a later session; tw-gpu leaves it alone
	# meanwhile, since with no GPUs named tw has them all open.
	wake_step='command -v tw-gpu >/dev/null 2>&1 && tw-gpu run true'
elif [ -z "${WLR_DRM_DEVICES:-}" ] && [ -z "${TW_ALL_GPUS:-}" ]; then
	gpus=0
	cards=
	boot=
	others=
	# A GPU is any display controller: VGA (0x0300), but also 3D (0x0302)
	# and other (0x0380), which is what the second GPU of many laptops calls
	# itself, and the first of some.
	for card in "$sys"/class/drm/card[0-9]*; do
		case ${card##*/} in *-*) continue ;; esac # a connector, not a card
		case $(cat "$card/device/class" 2>/dev/null) in 0x03*) ;; *) continue ;; esac
		gpus=$((gpus + 1))
		cards="$cards ${card##*/}"
		[ "$(cat "$card/device/boot_vga" 2>/dev/null)" = 1 ] && boot=${card##*/}
	done
	# The first GPU is the one with the built-in panel connected. Without
	# one (a desktop), the one the firmware showed the boot screen on. The
	# kernel tracks that only among VGA controllers: where the integrated
	# GPU is of another class, it is the NVIDIA GPU or none at all, which is
	# why the panel comes first. Else the first that is not NVIDIA's: a
	# laptop's second GPU is.
	for card in $cards; do
		if connected "$card" eDP LVDS DSI; then
			primary=$card
			why="the built-in panel"
			break
		fi
	done
	if [ -z "$primary" ] && [ -n "$boot" ]; then
		primary=$boot
		why="the boot VGA device"
	fi
	if [ -z "$primary" ]; then
		for card in $cards; do
			if [ "$(cat "$sys/class/drm/$card/device/vendor" 2>/dev/null)" != 0x10de ]; then
				primary=$card
				why="not NVIDIA's"
				break
			fi
		done
	fi
	for card in $cards; do
		[ "$card" != "$primary" ] && connected "$card" && others="$others:/dev/dri/$card"
	done
	# A GPU whose driver is not loaded has no card, and one that tw-gpu has
	# switched off is not even on the bus. Both count all the same: tw-gpu
	# brings the NVIDIA GPU back while tw runs, and tw must not pick it up
	# when that happens.
	for gpu in "$sys"/bus/pci/devices/*; do
		case $(cat "$gpu/class" 2>/dev/null) in
		0x03*) [ -d "$gpu/drm" ] || gpus=$((gpus + 1)) ;;
		esac
	done
	[ -e "$run/tw-gpu-off" ] && gpus=$((gpus + 1))
	if [ "$gpus" -gt 1 ] && [ -n "$primary" ]; then
		# Naming the GPUs also stops tw from opening one that appears later.
		export WLR_DRM_DEVICES="/dev/dri/$primary$others"
		# With one GPU in use, likewise keep the other vendor's libraries
		# out of the session when that GPU uses Mesa. Programs started from
		# tw inherit this and render on the same GPU, and none of them wakes
		# the other one by merely asking which GPUs there are. `tw-gpu run
		# <program>` starts one that should use the other GPU.
		# With two in use tw needs the second vendor's library itself.
		driver=$(basename "$(readlink "$sys/class/drm/$primary/device/driver")")
		mesa_egl=$share/glvnd/egl_vendor.d/50_mesa.json
		if [ -z "$others" ] && [ "$driver" != nvidia ] && [ -f "$mesa_egl" ]; then
			export __EGL_VENDOR_LIBRARY_FILENAMES="$mesa_egl"
			# By the driver manifest's name, so that a Mesa update during
			# the session that adds or renames a manifest changes nothing.
			export VK_LOADER_DRIVERS_DISABLE='*nvidia*'
			# Nothing in the session uses the second GPU now, so switch it
			# off for good, until a program asks for it through tw-gpu.
			# (`login` and not `off`: the login screen still holds the GPU
			# for a few seconds, and `login` waits for it to let go.) What
			# it says goes to the journal: a GPU left on by a failure that
			# nobody sees costs battery all session.
			gpu_step='command -v tw-gpu >/dev/null 2>&1 && { tw-gpu login 2>&1 | systemd-cat -t tw-gpu; } &'
		fi
	fi
fi

# The accessibility bus. GTK programs start it as they start: three
# processes that then stay for the session, for a screen reader or another
# aid to listen on. With none in use, tell the toolkits to leave it alone. Programs
# tw starts inherit that. The ones D-Bus and systemd start do not (the
# portal that shows file dialogs is one, and is what starts the bus at
# login), so they are told once tw is up, along with where the session is.
#
# Chromium and Electron programs ask the session bus for the accessibility
# bus whatever the toolkits were told, and the session bus would start it
# for them. Its unit therefore starts only where systemd has not been told
# NO_AT_BRIDGE (tw-a11y.conf).
#
# What D-Bus and systemd are told, and what they are told to forget: a
# session before this one may have told them otherwise, and systemd
# remembers for as long as the user is logged in anywhere.
service_env='WAYLAND_DISPLAY XDG_CURRENT_DESKTOP'
forget=
if [ -z "${TW_A11Y:-}" ]; then
	export NO_AT_BRIDGE=1 # GTK 3
	export GTK_A11Y=none  # GTK 4
	service_env="$service_env NO_AT_BRIDGE GTK_A11Y"
else
	forget="$forget NO_AT_BRIDGE GTK_A11Y"
fi
# The GPU the programs are kept on, above, holds for the portals too: one
# started while the NVIDIA GPU is on for another program would otherwise
# open it and keep it on.
if [ -n "${__EGL_VENDOR_LIBRARY_FILENAMES:-}" ]; then
	service_env="$service_env __EGL_VENDOR_LIBRARY_FILENAMES VK_LOADER_DRIVERS_DISABLE"
else
	forget="$forget __EGL_VENDOR_LIBRARY_FILENAMES VK_LOADER_DRIVERS_DISABLE"
fi

if [ -n "${TW_SESSION_PRINT:-}" ]; then
	echo "before tw starts=$wake_step"
	echo "WLR_DRM_DEVICES=${WLR_DRM_DEVICES-}"
	echo "first GPU=$primary${why:+, $why}"
	echo "__EGL_VENDOR_LIBRARY_FILENAMES=${__EGL_VENDOR_LIBRARY_FILENAMES-}"
	echo "VK_LOADER_DRIVERS_DISABLE=${VK_LOADER_DRIVERS_DISABLE-}"
	echo "once tw is up=$gpu_step"
	echo "NO_AT_BRIDGE=${NO_AT_BRIDGE-} GTK_A11Y=${GTK_A11Y-}"
	echo "told to services=$service_env"
	echo "taken back=$forget"
	exit 0
fi

# Once tw is up: tell D-Bus and systemd about the session so portals and
# services can find it, then run the user's autostart script. DISPLAY is
# tw's only if tw opened an X11 display (it is unset above), and only tw's
# child knows: without one, an X server an earlier session named is taken
# back. dbus-update-activation-environment cannot unset a variable, so D-Bus
# gets an empty one, which X11 programs read as none; systemd unsets it.
startup='
display=DISPLAY forget="'"$forget"'"
[ -n "${DISPLAY:-}" ] || display=DISPLAY= forget="$forget DISPLAY"
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
	dbus-update-activation-environment --systemd '"$service_env"' $display
fi
if [ -n "$forget" ] && command -v systemctl >/dev/null 2>&1; then
	systemctl --user unset-environment $forget
fi
'"$gpu_step"'
autostart="${XDG_CONFIG_HOME:-$HOME/.config}/tw/autostart"
if [ -x "$autostart" ]; then
	exec "$autostart"
fi
'

# Prefer the tw installed next to this script.
tw=$(dirname "$0")/tw
[ -x "$tw" ] || tw=tw

# A system update can take away a library tw was built against (the file's
# name carries a version), and tw then cannot start until it is built again.
# The loader names the library and nothing else; at a text console, with no
# desktop to look things up on, say what to do about it.
if command -v "$tw" >/dev/null 2>&1; then
	"$tw" -h >/dev/null 2>&1
	if [ $? = 127 ]; then
		cat >&2 <<EOF
tw-session: tw cannot start. A library it was built against is gone, most
likely replaced by a newer version in a system update. Build tw again, in
its source directory:
    meson setup --wipe build-release
    meson compile -C build-release
    sudo meson install -C build-release --no-rebuild --skip-subprojects
What the loader says:
EOF
	fi
fi
[ -z "$wake_step" ] || eval "$wake_step"

# When tw exits, take back from systemd what the startup command handed on.
# systemd keeps it for as long as the user is logged in anywhere, and a
# desktop started next imports it (Plasma does): it would run with the
# accessibility bus off and the NVIDIA GPU out of its programs' reach. So
# tw is not exec'd; this shell waits for it, which costs about 300 KB and
# no wakeups. A signal that ends the session reaches tw too, and the trap
# keeps this shell until tw is gone (tw itself gets the default handling).
trap : HUP TERM
"$tw" -s "$startup"
status=$?
if command -v systemctl >/dev/null 2>&1; then
	systemctl --user unset-environment $service_env DISPLAY 2>/dev/null
fi
# A tw that ended while the screen was off, by a crash or a signal, left the
# keyboards and mice let sleep (tw-power away), and they may lose keys as they
# wake: wake them for good.
if [ -e "$run/tw-power-away" ] && command -v tw-power >/dev/null 2>&1; then
	tw-power back 2>/dev/null
fi
exit $status
